# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database
DATABASE_URL=sqlite:///ai-image/ai_studio.db

# AI Provider
# - pollinations: REAL AI image generation (understands prompts, e.g. "a
#   cat" actually draws a cat). Free, no signup/API key needed — uses the
#   open-source Pollinations.ai service over the internet. If the request
#   fails for any reason (offline, service down), it automatically falls
#   back to the local "stub" engine for that image so generation never
#   just breaks.
# - stub: fully offline, no internet required. Produces real but abstract
#   generative art (not recognizable objects/scenes) — useful for offline
#   development or if you'd rather not depend on an external service.
# - To use a paid provider (OpenAI, Stability AI, etc.) instead, set
#   AI_PROVIDER to that provider's name and put its key in AI_API_KEY.
AI_PROVIDER=pollinations
AI_API_KEY=your-api-key-here

# Uploads
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=ai-image/uploads

# Logging
LOG_LEVEL=INFO

# CORS (if needed)
CORS_ORIGINS=http://localhost:5000
